{
  "info": {
    "name": "Payment Manager",
    "description": "Requests for the Payment Manager API. Run the collection in order: later requests use the ids saved by earlier ones. Set `baseUrl` to `http://localhost:8080` (backend) or `http://localhost:3000/api` (Docker full stack, through nginx).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create",
      "item": [
        {
          "name": "Create an approved payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchantId\": \"COMMERCE_001\",\n  \"amount\": 15000,\n  \"currency\": \"ARS\",\n  \"simulationResult\": \"APPROVED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 201 with an approved payment', () => {",
                  "    pm.response.to.have.status(201);",
                  "    pm.expect(pm.response.json().status).to.eql('APPROVED');",
                  "});",
                  "pm.collectionVariables.set('approvedPaymentId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create a rejected payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchantId\": \"COMMERCE_001\",\n  \"amount\": 32500,\n  \"currency\": \"ARS\",\n  \"simulationResult\": \"REJECTED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 201 with a rejected payment', () => {",
                  "    pm.response.to.have.status(201);",
                  "    pm.expect(pm.response.json().status).to.eql('REJECTED');",
                  "});",
                  "pm.collectionVariables.set('rejectedPaymentId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create a payment with invalid fields",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchantId\": \"\",\n  \"amount\": -10,\n  \"currency\": \"ARS\",\n  \"simulationResult\": \"APPROVED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 400 with the field errors', () => {",
                  "    pm.response.to.have.status(400);",
                  "    pm.expect(pm.response.json().errors).to.have.keys('merchantId', 'amount');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Query",
      "item": [
        {
          "name": "List payments",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payments?page=0&size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200 with a page of payments', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().content).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List approved payments",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payments?status=APPROVED",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "APPROVED"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns only approved payments', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.response.json().content.forEach(payment => pm.expect(payment.status).to.eql('APPROVED'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get a payment",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payments/{{approvedPaymentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "{{approvedPaymentId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200 with the payment', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('approvedPaymentId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get a payment that does not exist",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payments/pay_unknown",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "pay_unknown"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Refund",
      "item": [
        {
          "name": "Refund an approved payment",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payments/{{approvedPaymentId}}/refund",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "{{approvedPaymentId}}",
                "refund"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200 with the payment refunded', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().status).to.eql('REFUNDED');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Refund the same payment again",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payments/{{approvedPaymentId}}/refund",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "{{approvedPaymentId}}",
                "refund"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 409 because it was already refunded', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refund a rejected payment",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payments/{{rejectedPaymentId}}/refund",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "{{rejectedPaymentId}}",
                "refund"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 409 because it was rejected', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Idempotency",
      "item": [
        {
          "name": "Create a payment with an Idempotency-Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchantId\": \"COMMERCE_002\",\n  \"amount\": 8200,\n  \"currency\": \"ARS\",\n  \"simulationResult\": \"APPROVED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 201 with the new payment', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('idempotentPaymentId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Retry with the same key and body",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchantId\": \"COMMERCE_002\",\n  \"amount\": 8200,\n  \"currency\": \"ARS\",\n  \"simulationResult\": \"APPROVED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns the same payment instead of creating another', () => {",
                  "    pm.response.to.have.status(201);",
                  "    pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('idempotentPaymentId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reuse the key with a different body",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchantId\": \"COMMERCE_002\",\n  \"amount\": 9000,\n  \"currency\": \"ARS\",\n  \"simulationResult\": \"APPROVED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 422', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "approvedPaymentId",
      "value": ""
    },
    {
      "key": "rejectedPaymentId",
      "value": ""
    },
    {
      "key": "idempotencyKey",
      "value": ""
    },
    {
      "key": "idempotentPaymentId",
      "value": ""
    }
  ]
}
